<script>
// Personalize with agent name from session
(function(){
  try {
    const s = JSON.parse(localStorage.getItem('hub_session') || 'null');
    if (s && s.name) {
      const firstName = s.name.split(' ')[0];
      const greeting = document.getElementById('hub-greeting');
      if (greeting) greeting.textContent = 'Hi, ' + firstName + ' — welcome back.';
    }
  } catch(e){}
})();

const SEARCH_INDEX = [
  {icon:'✍️',title:'Sunfire — SOA & Enrollments',desc:'Send Scope of Appointment, enroll clients, collect signatures.',tags:['sunfire','soa','enroll','quote','enrollment','scope'],url:'/tools-perks.html'},
  {icon:'🗓',title:'SEP Tracker',desc:'Live disaster Special Enrollment Periods — Florida + all states.',tags:['sep','disaster','special enrollment','hurricane','flood','storm','milton'],url:'/sep-tracker.html'},
  {icon:'🎓',title:'AHIP Medicare Training',desc:'Required annual certification — use the discounted THEI portal.',tags:['ahip','certification','annual','cert','training'],url:'/certs-compliance.html'},
  {icon:'📚',title:'WebCE Continuing Education',desc:'Complete CE hours to maintain your insurance license.',tags:['webce','ce','continuing education','license','hours'],url:'/tools-perks.html'},
  {icon:'🛡️',title:'E&O Insurance',desc:'Agency-negotiated pricing — required for Medicare contracting.',tags:['e&o','errors','omissions','eo','insurance'],url:'/tools-perks.html'},
  {icon:'🪪',title:'Florida DFS (MyProfile)',desc:'Manage your FL license, CE compliance, and appointments.',tags:['dfs','license','florida','myprofile','appointment'],url:'/tools-perks.html'},
  {icon:'📊',title:'2026 MAPD Plan Comparison Grid',desc:'Side-by-side benefits, copays, OTC, dental, vision for all 2026 plans.',tags:['plan','mapd','grid','comparison','2026','benefits','plan grid'],url:'/learn.html'},
  {icon:'🩺',title:'Chronic Condition Eligibility',desc:'C-SNP, D-SNP, and MA coverage by condition — all carriers.',tags:['chronic','condition','snp','csnp','dsnp','eligibility'],url:'/chronic-conditions.html'},
  {icon:'📞',title:'Carrier Contact Guide',desc:'Auth lines, member services, OTC, HRA, pharmacy — all carriers.',tags:['carrier','contact','humana','aetna','solis','devoted','uhc','united','careplus','hra','otc','auth','member services','pharmacy','oscar','wellcare'],url:'/carrier-contact-guide.html'},
  {icon:'📋',title:'AgentSync — Contracting',desc:'Carrier onboarding, contracting docs, appointment tracking.',tags:['agentsync','contracting','onboarding','contract','appointment'],url:'/tools-perks.html'},
  {icon:'📋',title:'Nextere — Contracting',desc:'Contracting for Doctors Health, Solis, Gold Kidney, HealthSun.',tags:['nextere','doctors health','solis','gold kidney','healthsun','contracting'],url:'/tools-perks.html'},
  {icon:'💊',title:'Medicaid & LIS / Extra Help',desc:'QMB, SLMB, income limits and eligibility rules.',tags:['medicaid','lis','extra help','qmb','slmb','income','low income'],url:'/learn.html'},
  {icon:'📧',title:'Retention Email Templates',desc:'7 client email templates — birthday, AEP, mid-year, annual review.',tags:['retention','email','template','birthday','aep','annual review','client'],url:'/retention-toolkit.html'},
  {icon:'📅',title:'Retention Calendar',desc:'Year-round client touchpoint calendar for renewals.',tags:['retention','calendar','renewal','touchpoint'],url:'/retention-toolkit.html'},
  {icon:'🎓',title:'Broker University',desc:'Medicare basics, sales scripts, training guides, lead gen resources.',tags:['training','university','learn','medicare basics','sales','script','education','basics'],url:'/learn.html'},
  {icon:'📇',title:'Business Card Generator (EN)',desc:'Generate your THEI-branded digital business card instantly.',tags:['business card','card','generator','digital','brand','tarjeta'],url:'https://moonlit-douhua-e20b2a.netlify.app/'},
  {icon:'📇',title:'Business Card Generator (ES)',desc:'Genera tu tarjeta digital de THEI en segundos.',tags:['tarjeta','business card','spanish','espanol','generator'],url:'https://boisterous-truffle-d00468.netlify.app/'},
  {icon:'📰',title:'Agent Pulse — Live Updates',desc:'Latest Medicare regulatory changes, carrier alerts, and industry news.',tags:['pulse','news','alerts','regulatory','update','industry','cms'],url:'/agent-pulse.html'},
  {icon:'🔗',title:'MedicarePRO CRM',desc:'CRM for managing leads and client pipeline.',tags:['medicaRepro','crm','leads','pipeline','pro'],url:'/tools-perks.html'},
  {icon:'🔗',title:'XCLUSIVE CRM',desc:'CRM platform access for agents.',tags:['xclusive','crm','platform'],url:'/tools-perks.html'},
  {icon:'✅',title:'Certs & Compliance',desc:'Carrier certifications, CMS guidelines, certification deadlines.',tags:['certs','compliance','carrier cert','cms','certify','deadline'],url:'/certs-compliance.html'},
];

function hubSearch(q){}
// Load news bulletin from pulse-feed.json
async function loadNewsBulletin() {
  try {
    const res = await fetch('/files/pulse-feed.json?v=' + Date.now());
    const data = await res.json();
    if (!data.alerts || !data.alerts.length) return;
    const now = Date.now();
    const cutoff = now - (60 * 24 * 60 * 60 * 1000); // 60 days
    const recent = data.alerts.filter(a => {
      const d = new Date(a.date);
      return !isNaN(d) && d.getTime() >= cutoff;
    });
    if (!recent.length) return;
    const items = recent.map(a => {
      const url = a.source || '/agent-pulse.html';
      const external = a.source && a.source.startsWith('http');
      return `<a href="${url}" ${external ? 'target="_blank" rel="noopener"' : ''} style="display:inline-flex;align-items:center;gap:8px;padding:0 28px;border-right:1px solid #F1ECF6;text-decoration:none;">
        <span style="font:600 12.5px/1 Arial,sans-serif;color:#452068;">${a.title}</span>
        <span style="font:400 11px/1 Arial,sans-serif;color:#C9B8DF;">${a.date}</span>
      </a>`;
    }).join('');
    document.getElementById('ticker-items').innerHTML = items;
    document.getElementById('ticker-items-clone').innerHTML = items;
    document.getElementById('news-ticker').style.display = 'block';
  } catch(e) {}
}
loadNewsBulletin();


// ── Coach-mark tour ─────────────────────────────────────────────────────────
const TOUR_STEPS = [
  {
    targetId: null, // hero/welcome area — no spotlight
    title: "Welcome to your Agent Hub 👋",
    desc: "Everything you need as a licensed THEI agent — certs, tools, retention, and live SEP data — one click away. This quick tour shows you around.",
    arrow: "arrow-top",
    bubblePos: {top: "140px", left: "50%", transform: "translateX(-50%)"}
  },
  {
    targetSelector: ".cat-card[href='/retention-toolkit.html']",
    title: "Retention Toolkit",
    desc: "Your flagship retention resource — bilingual email templates for every client touchpoint all year. This is the #1 tool for protecting your renewal commissions.",
    arrow: "arrow-top",
    offset: {x: 0, y: 14}
  },
  {
    targetSelector: ".cat-card[href='/sep-tracker.html']",
    title: "SEP Tracker — Your Sales Edge 🗓",
    desc: "Disaster Special Enrollment Periods open enrollment windows outside AEP. When a disaster hits, your clients can switch plans. This tracker keeps you ahead of every opportunity.",
    arrow: "arrow-top",
    offset: {x: 0, y: 14}
  },
  {
    targetSelector: ".pill-nav",
    title: "One-click navigation",
    desc: "Everything is one click from anywhere — Broker University, SEP Tracker, Certs, Carrier Guide, HRA Guide. Use the nav anytime to jump between sections.",
    arrow: "arrow-bottom",
    offset: {x: 0, y: -14}
  },
  {
    targetId: "tourBtn",
    title: "Replay this tour anytime",
    desc: "Need a refresher? Click the ? icon in the nav anytime to restart the tour from the beginning.",
    arrow: "arrow-top",
    offset: {x: 0, y: 10}
  }
];

let _tourStep = 0;

function startTour() {
  _tourStep = 0;
  showTourStep();
}

function showTourStep() {
  const step = TOUR_STEPS[_tourStep];
  const overlay = document.getElementById('tourOverlay');
  const spotlight = document.getElementById('tourSpotlight');
  const bubble = document.getElementById('tourBubble');
  const label = document.getElementById('tourStepLabel');
  const title = document.getElementById('tourTitle');
  const desc = document.getElementById('tourDesc');
  const dots = document.getElementById('tourDots');
  const nextBtn = document.getElementById('tourNextBtn');

  overlay.classList.add('active');
  document.body.style.overflow = 'hidden';

  // Content
  label.textContent = 'Step ' + (_tourStep + 1) + ' of ' + TOUR_STEPS.length;
  title.textContent = step.title;
  desc.textContent = step.desc;
  nextBtn.textContent = _tourStep === TOUR_STEPS.length - 1 ? 'Got it ✓' : 'Next →';

  // Dots
  dots.innerHTML = TOUR_STEPS.map((_, i) =>
    '<span class="tour-dot' + (i === _tourStep ? ' active' : '') + '"></span>'
  ).join('');

  // Spotlight target
  let el = null;
  if (step.targetId) el = document.getElementById(step.targetId);
  else if (step.targetSelector) el = document.querySelector(step.targetSelector);

  // Reset bubble classes
  bubble.className = 'tour-bubble ' + (step.arrow || '');

  if (el) {
    const r = el.getBoundingClientRect();
    const pad = 8;
    spotlight.style.cssText = [
      'left:' + (r.left - pad) + 'px',
      'top:' + (r.top - pad) + 'px',
      'width:' + (r.width + pad*2) + 'px',
      'height:' + (r.height + pad*2) + 'px',
      'display:block'
    ].join(';');

    // Position bubble relative to spotlight
    const off = step.offset || {x:0, y:14};
    if (step.arrow === 'arrow-top') {
      bubble.style.cssText = 'top:' + (r.bottom + pad + off.y) + 'px;left:' + Math.max(12, r.left - 10 + off.x) + 'px;';
    } else if (step.arrow === 'arrow-bottom') {
      bubble.style.cssText = 'bottom:' + (window.innerHeight - r.top + pad + Math.abs(off.y)) + 'px;left:' + Math.max(12, r.left - 10 + off.x) + 'px;';
    } else if (step.arrow === 'arrow-right') {
      bubble.style.cssText = 'top:' + (r.top + off.y) + 'px;right:' + (window.innerWidth - r.left + pad + 12) + 'px;';
    }
  } else {
    spotlight.style.display = 'none';
    const pos = step.bubblePos || {top:'40%', left:'50%', transform:'translateX(-50%)'};
    let css = '';
    for (const [k,v] of Object.entries(pos)) css += k + ':' + v + ';';
    bubble.style.cssText = css;
  }
}

function tourNext() {
  if (_tourStep >= TOUR_STEPS.length - 1) { endTour(); return; }
  _tourStep++;
  showTourStep();
}

function endTour() {
  document.getElementById('tourOverlay').classList.remove('active');
  document.body.style.overflow = '';
  localStorage.setItem('hub_tour_done', '1');
}

// Auto-start on first visit
document.addEventListener('DOMContentLoaded', function() {
  if (!localStorage.getItem('hub_tour_done')) {
    setTimeout(startTour, 800);
  }
});

function logout() {
  localStorage.removeItem('hub_session');
  window.location.replace('/login.html');
}

(function(){
  const input = document.getElementById('hubSearch');
  const dropdown = document.getElementById('searchDropdown');
  let focusIdx = -1;

  function getResults(q){
    if(!q || q.length < 2) return [];
    return SEARCH_INDEX.filter(item =>
      item.tags.some(t => t.includes(q)) ||
      item.title.toLowerCase().includes(q) ||
      item.desc.toLowerCase().includes(q)
    ).slice(0, 7);
  }

  function renderDropdown(results){
    focusIdx = -1;
    if(!results.length){
      dropdown.innerHTML = '<div class="search-no-results">No results — try a different term</div>';
    } else {
      dropdown.innerHTML = results.map((r,i) =>
        `<a class="search-result" href="${r.url}" data-idx="${i}">
          <span class="sr-icon">${r.icon}</span>
          <span class="sr-text"><div class="sr-title">${r.title}</div><div class="sr-desc">${r.desc}</div></span>
        </a>`
      ).join('');
    }
    dropdown.classList.add('open');
  }

  function closeDropdown(){ dropdown.classList.remove('open'); dropdown.innerHTML=''; focusIdx=-1; }

  input.addEventListener('input', function(){
    const q = this.value.toLowerCase().trim();
    if(!q){ closeDropdown(); return; }
    renderDropdown(getResults(q));
  });

  input.addEventListener('keydown', function(e){
    const items = dropdown.querySelectorAll('.search-result');
    if(e.key==='ArrowDown'){ e.preventDefault(); focusIdx=Math.min(focusIdx+1,items.length-1); items.forEach((el,i)=>el.classList.toggle('focused',i===focusIdx)); }
    else if(e.key==='ArrowUp'){ e.preventDefault(); focusIdx=Math.max(focusIdx-1,0); items.forEach((el,i)=>el.classList.toggle('focused',i===focusIdx)); }
    else if(e.key==='Enter'){ if(focusIdx>=0 && items[focusIdx]){ window.location.href=items[focusIdx].href; } else if(items.length===1){ window.location.href=items[0].href; } }
    else if(e.key==='Escape'){ closeDropdown(); this.value=''; }
  });

  document.addEventListener('click', function(e){
    if(!e.target.closest('.search-wrap')) closeDropdown();
  });
})();
</script>
<!-- Non-Comm Modal -->
<div class="nc-modal-backdrop" id="ncModalBackdrop" onclick="if(event.target===this)closeNcModal()">
  <div class="nc-modal">
    <div class="nc-modal-head">
      <h2 id="ncModalTitle">Plans</h2>
      <button class="nc-modal-close" onclick="closeNcModal()">✕</button>
    </div>
    <div class="nc-modal-filters">
      <select id="ncStateFilter" onchange="renderNcPlans()"><option value="">All states</option></select>
      <input type="search" id="ncPlanSearch" placeholder="Search plans…" oninput="renderNcPlans()">
    </div>
    <div class="nc-modal-body" id="ncModalBody"></div>
  </div>
</div>
</body>
