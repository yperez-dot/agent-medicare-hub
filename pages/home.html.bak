<!doctype html>
<html lang="en">
<head>
<script>
(function(){
  // Preview bypass — ?preview=THEI allows viewing without login
  if (new URLSearchParams(window.location.search).get('preview') === 'THEI') return;
  try {
    var s = JSON.parse(localStorage.getItem('hub_session') || 'null');
    if (!s || !s.token || s.expires < Date.now()) {
      localStorage.removeItem('hub_session');
      window.location.replace('/login.html');
    }
  } catch(e) {
    window.location.replace('/login.html');
  }
})();
</script>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Agent Hub | The Health Experts Insurance</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:Arial,Helvetica,sans-serif;background:#F6F5F8;color:#241C2E;font-size:15px;line-height:1.55;}

/* Top nav */
.top-bar{background:#fff;border-bottom:1px solid #E7E4ED;display:flex;flex-direction:row;align-items:center;justify-content:space-between;padding:12px 32px;}
.logo-wrap img{height:56px;width:auto;}
.pill-nav{display:flex;gap:10px;flex-wrap:wrap;}
.pill-nav a{display:inline-block;padding:9px 20px;border:1.5px solid #E7E4ED;border-radius:999px;font:600 13px/1 Arial,sans-serif;color:#452068;text-decoration:none;transition:all .15s;}
.pill-nav a:hover,.pill-nav a.active{background:#452068;border-color:#452068;color:#fff;}

/* Hero */
.hero{background:linear-gradient(135deg,#452068 0%,#341751 100%);padding:48px 32px;text-align:center;}
.hero h1{font-size:32px;font-weight:700;color:#fff;margin-bottom:8px;line-height:1.2;}
.hero h1 span{color:#FF1090;}
.hero p{font-size:15px;color:rgba(255,255,255,0.85);margin-bottom:28px;}
.search-wrap{max-width:680px;margin:0 auto;position:relative;}
.search-wrap input{width:100%;padding:14px 20px;border-radius:999px;border:none;font:400 14px/1 Arial,sans-serif;color:#241C2E;outline:none;box-shadow:0 4px 20px rgba(0,0,0,0.15);}
.search-wrap input::placeholder{color:#9A94A8;}
.search-dropdown{position:absolute;top:calc(100% + 8px);left:0;right:0;background:#fff;border-radius:16px;box-shadow:0 8px 32px rgba(36,28,46,0.16);overflow:hidden;z-index:999;display:none;}
.search-dropdown.open{display:block;}
.search-result{display:flex;align-items:center;gap:12px;padding:12px 18px;cursor:pointer;text-decoration:none;color:#241C2E;border-bottom:1px solid #F1ECF6;transition:background .1s;}
.search-result:last-child{border-bottom:none;}
.search-result:hover,.search-result.focused{background:#F6F5F8;}
.sr-icon{font-size:18px;flex-shrink:0;}
.sr-text{flex:1;}
.sr-title{font:600 13.5px/1.2 Arial,sans-serif;color:#241C2E;margin-bottom:3px;}
.sr-desc{font:400 11.5px/1.3 Arial,sans-serif;color:#6E687C;}
.search-no-results{padding:16px 18px;font:400 13px/1 Arial,sans-serif;color:#9A94A8;text-align:center;}

/* Sections */
.wrap{max-width:1100px;margin:0 auto;padding:40px 24px 64px;}
.section-label{font:700 11px/1 Arial,sans-serif;text-transform:uppercase;letter-spacing:.8px;color:#9A94A8;margin-bottom:16px;}
.section-label span{color:#FF1090;}

/* Category cards */
.cat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:40px;}
.cat-card{background:#fff;border:1px solid #E7E4ED;border-radius:16px;padding:22px;text-decoration:none;color:#241C2E;transition:box-shadow .15s,transform .15s;display:block;}
.cat-card:hover{box-shadow:0 8px 24px rgba(69,32,104,.12);transform:translateY(-2px);}
.cat-card .cat-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:14px;}
.cat-card h3{font-size:16px;font-weight:700;color:#241C2E;margin-bottom:6px;}
.cat-card p{font-size:13px;color:#6E687C;margin-bottom:10px;line-height:1.5;}
.cat-card .best-for{font:600 11px/1 Arial,sans-serif;color:#452068;text-transform:uppercase;letter-spacing:.4px;}

/* Two-col resources */
.two-col{display:grid;grid-template-columns:1.4fr 1fr;gap:20px;}
.res-card{background:#fff;border:1px solid #E7E4ED;border-radius:16px;padding:24px;}
.res-card h3{font-size:16px;font-weight:700;margin-bottom:16px;color:#241C2E;}
.res-item{display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px solid #E7E4ED;text-decoration:none;color:#241C2E;}
.res-item:last-child{border-bottom:none;}
.res-item:hover .res-name{color:#452068;}
.res-name{font:600 13.5px/1 Arial,sans-serif;}
.res-tag{font:700 10px/1 Arial,sans-serif;text-transform:uppercase;padding:3px 9px;border-radius:999px;letter-spacing:.3px;}
.tag-pink{background:#FFE8F3;color:#D10E78;}
.tag-purple{background:#F1ECF6;color:#452068;}
.tag-green{background:#E3F5EC;color:#1E8A5C;}
.ql-item{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid #E7E4ED;text-decoration:none;color:#241C2E;}
.ql-item:last-child{border-bottom:none;}
.ql-item:hover .ql-name{color:#452068;}
.ql-left{display:flex;flex-direction:column;gap:3px;}
.ql-name{font:700 13.5px/1 Arial,sans-serif;}
.ql-desc{font:400 11.5px/1 Arial,sans-serif;color:#9A94A8;}
.ql-arrow{color:#452068;font-size:16px;}


/* Non-comm sidebar */
.nc-sidebar{background:#fff;border:2px solid #DC2626;border-radius:14px;overflow:hidden;width:240px;flex-shrink:0;align-self:flex-start;position:sticky;top:80px;}
.nc-sidebar-header{background:#DC2626;padding:12px 16px;display:flex;align-items:center;gap:8px;}
.nc-sidebar-header span{font:800 12px/1 Arial,sans-serif;color:#fff;text-transform:uppercase;letter-spacing:0.6px;}
.nc-carrier-btn{width:100%;background:none;border:none;border-bottom:1px solid #FEE2E2;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;text-align:left;transition:background .12s;}
.nc-carrier-btn:last-child{border-bottom:none;}
.nc-carrier-btn:hover{background:#FEF2F2;}
.nc-carrier-name{font:600 13px/1 Arial,sans-serif;color:#241C2E;}
.nc-carrier-meta{font:400 11px/1 Arial,sans-serif;color:#9A94A8;margin-top:2px;}
.nc-badge{font:700 10px/1 Arial,sans-serif;background:#FEE2E2;color:#991B1B;padding:2px 7px;border-radius:999px;}
/* Modal */
.nc-modal-backdrop{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:9000;align-items:center;justify-content:center;padding:20px;}
.nc-modal-backdrop.open{display:flex;}
.nc-modal{background:#fff;border-radius:20px;width:100%;max-width:680px;max-height:85vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,0.25);overflow:hidden;}
.nc-modal-head{padding:20px 24px;border-bottom:1px solid #F1ECF6;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-shrink:0;}
.nc-modal-head h2{font:700 18px/1 Arial,sans-serif;color:#241C2E;}
.nc-modal-close{background:none;border:none;font-size:22px;cursor:pointer;color:#9A94A8;line-height:1;}
.nc-modal-close:hover{color:#241C2E;}
.nc-modal-filters{padding:14px 24px;border-bottom:1px solid #F1ECF6;flex-shrink:0;}
.nc-modal-filters select,.nc-modal-filters input{padding:8px 12px;border:1.5px solid #E7E4ED;border-radius:10px;font:400 13px/1 Arial,sans-serif;outline:none;margin-right:8px;}
.nc-modal-filters select:focus,.nc-modal-filters input:focus{border-color:#452068;}
.nc-modal-body{overflow-y:auto;padding:16px 24px 24px;flex:1;}
.nc-state-section{margin-bottom:16px;}
.nc-state-label{font:700 11px/1 Arial,sans-serif;text-transform:uppercase;letter-spacing:0.5px;color:#452068;margin-bottom:8px;}
.nc-plan-chip{display:inline-block;margin:3px 4px 3px 0;padding:4px 10px;background:#FEF2F2;border:1px solid #FECACA;border-radius:6px;font:400 12px/1.4 Arial,sans-serif;color:#991B1B;}

/* Coach-mark tour */
.tour-overlay{display:none;position:fixed;inset:0;z-index:8000;pointer-events:none;}
.tour-overlay.active{display:block;}
.tour-dim{position:fixed;inset:0;background:rgba(27,18,48,.65);z-index:8001;pointer-events:all;}
.tour-spotlight{position:fixed;z-index:8002;border-radius:16px;box-shadow:0 0 0 4px #fff,0 0 0 9999px rgba(27,18,48,.65);pointer-events:none;transition:all .3s ease;}
.tour-bubble{position:fixed;z-index:8003;background:#fff;border-radius:14px;padding:18px 20px;width:280px;box-shadow:0 16px 40px rgba(27,18,48,.28);}
.tour-bubble::before{content:'';position:absolute;width:12px;height:12px;background:#fff;transform:rotate(45deg);}
.tour-bubble.arrow-top::before{top:-6px;left:36px;}
.tour-bubble.arrow-bottom::before{bottom:-6px;left:36px;}
.tour-bubble.arrow-right::before{top:14px;right:-6px;}
.tour-step-label{font:700 10.5px/1 Arial,sans-serif;color:#D10E78;text-transform:uppercase;letter-spacing:.5px;margin-bottom:5px;}
.tour-bubble h4{font:700 14px/1.4 Arial,sans-serif;color:#241C2E;margin:0 0 10px;}
.tour-bubble p{font:400 13px/1.5 Arial,sans-serif;color:#6E687C;margin:0 0 14px;}
.tour-dots{display:flex;gap:5px;align-items:center;}
.tour-dot{width:6px;height:6px;border-radius:50%;background:#E7E4ED;}
.tour-dot.active{background:#FF1090;}
.tour-actions{display:flex;align-items:center;justify-content:space-between;margin-top:12px;}
.tour-skip{font:600 12px/1 Arial,sans-serif;color:#9A94A8;background:none;border:none;cursor:pointer;padding:0;}
.tour-skip:hover{color:#452068;}
.tour-next{font:700 12.5px/1 Arial,sans-serif;color:#D10E78;background:none;border:none;cursor:pointer;padding:0;}
.tour-next:hover{opacity:.75;}


/* Sidebar accordion */

.noncomm-list{list-style:none;padding:0;margin:0;}
.noncomm-group-label{font:700 10px/1 Arial,sans-serif;color:#452068;text-transform:uppercase;letter-spacing:.03em;margin-top:10px;margin-bottom:4px;display:flex;align-items:center;gap:4px;}
.noncomm-group-label:first-child{margin-top:0;}
.noncomm-pending{font:600 8.5px/1 Arial,sans-serif;color:#B45309;background:#FEF3C7;border-radius:6px;padding:2px 6px;text-transform:none;letter-spacing:0;}
.noncomm-carrier{display:block;width:100%;text-align:left;padding:5px 8px;margin-bottom:3px;background:#FEF2F2;border:1px solid #FECACA;border-radius:6px;font:500 11.5px/1 Arial,sans-serif;color:#991B1B;cursor:pointer;transition:background .1s;}
.noncomm-carrier:hover{background:#FECACA;}

.nc-carrier-link{display:flex;align-items:center;padding:12px 16px;font:600 13px/1 Arial,sans-serif;
color:#241C2E;text-decoration:none;border-bottom:1px solid #FEE2E2;transition:background .1s;}
.nc-carrier-link:hover{background:#FEF2F2;color:#991B1B;}
.nc-acc-header{width:100%;background:none;border:none;border-bottom:1px solid #FEE2E2;padding:13px 16px;
  display:flex;align-items:center;justify-content:space-between;cursor:pointer;text-align:left;}
.nc-acc-header:last-of-type{border-bottom:none;}
.nc-acc-header:hover{background:#FEF2F2;}
.nc-acc-name{font:700 13px/1 Arial,sans-serif;color:#241C2E;}
.nc-acc-sub{font:400 11px/1 Arial,sans-serif;color:#9A94A8;margin-top:2px;}
.nc-acc-badge{font:700 10px/1 Arial,sans-serif;background:#FEE2E2;color:#991B1B;padding:2px 7px;border-radius:999px;flex-shrink:0;}
.nc-acc-body{display:none;padding:10px 16px 14px;border-bottom:1px solid #FEE2E2;background:#FFFAFA;}
.nc-acc-body.open{display:block;}
.nc-acc-chip{display:inline-block;margin:2px 3px 2px 0;padding:3px 8px;background:#FEF2F2;
  border:1px solid #FECACA;border-radius:5px;font:400 11px/1.4 Arial,sans-serif;color:#991B1B;}
.nc-acc-state{font:700 10px/1 Arial,sans-serif;text-transform:uppercase;letter-spacing:.4px;
  color:#452068;margin:8px 0 4px;}
.nc-state-search{width:100%;padding:7px 10px;border:1.5px solid #E7E4ED;border-radius:8px;
  font:400 12px/1 Arial,sans-serif;outline:none;margin-bottom:8px;}
.nc-state-search:focus{border-color:#DC2626;}

.nc-note{font-size:11.5px;color:#9A94A8;margin-top:14px;padding-top:12px;border-top:1px solid #F1ECF6;}
@media(max-width:900px){.page-body{grid-template-columns:1fr;}.nc-sidebar{position:static;}}

@media(max-width:768px){
  .cat-grid{grid-template-columns:1fr 1fr;}
  .two-col{grid-template-columns:1fr;}
  .pill-nav a{font-size:12px;padding:8px 14px;}
  .hero h1{font-size:24px;}
  .hero{padding:32px 20px;}
}
@media(max-width:480px){.cat-grid{grid-template-columns:1fr;}}
</style>
</head>
<body>

<div class="top-bar">
  <div class="logo-wrap"><img src="/files/thei-logo.png" alt="THEI"></div>
  <nav class="pill-nav">
    <a href="/home.html" class="active">Agent Dashboard</a>
    <a href="/learn.html">Broker University</a>
    <a href="/carrier-info.html">Carrier Info</a>
    <a href="/tools-perks.html">Agent Tools Hub</a>
    <a href="/retention-toolkit.html">Retention Toolkit</a>
    <a href="/sep-tracker.html">SEP Tracker</a>
    <a href="#" onclick="logout()" style="color:#D6336C;border-color:#F5C0C0;">Sign Out</a>
    <button onclick="startTour()" title="Replay hub tour" style="width:30px;height:30px;border-radius:50%;background:#452068;color:#fff;border:none;font:700 13px/1 Arial,sans-serif;cursor:pointer;flex-shrink:0;display:flex;align-items:center;justify-content:center;margin-left:4px;">?</button>
  </nav>
</div>

<!-- Hero -->
<div class="hero">
  <div id="hub-greeting" style="font:700 18px/1 Arial,sans-serif;color:rgba(255,255,255,0.9);margin-bottom:10px;letter-spacing:-0.2px;"></div>
  <h1><span style="color:#fff;">The Health Experts</span> Medicare Agent Hub</h1>
  <p>Start contracting, transfer your book, or access your most-used resources.</p>
  <div class="search-wrap">
    <input type="text" id="hubSearch" placeholder="Search the hub — try HRA, Sunfire, AHIP, SEP, Medicaid…" autocomplete="off">
    <div class="search-dropdown" id="searchDropdown"></div>
  </div>
</div>


<!-- News Ticker -->
<div id="news-ticker" style="display:none;background:#fff;overflow:hidden;width:100%;position:relative;border-bottom:2px solid #FF1090;border-top:2px solid #FF1090;">
  <div style="display:flex;align-items:stretch;">
    <a href="/agent-pulse.html" style="flex:none;display:flex;align-items:center;gap:8px;padding:0 18px;background:#FF1090;text-decoration:none;z-index:2;white-space:nowrap;">
      <span style="font:800 11px/1 Arial,sans-serif;color:#fff;text-transform:uppercase;letter-spacing:.8px;">Live</span>
    </a>
    <div style="flex:1;overflow:hidden;padding:10px 0;">
      <div id="ticker-track" style="display:inline-flex;gap:0;white-space:nowrap;animation:ticker-scroll 90s linear infinite;">
        <span id="ticker-items"></span>
        <span id="ticker-items-clone"></span>
      </div>
    </div>
    <a href="/agent-pulse.html" style="flex:none;display:flex;align-items:center;padding:0 16px;color:#FF1090;font:600 11px/1 Arial,sans-serif;text-decoration:none;white-space:nowrap;border-left:1px solid #F1ECF6;">View all →</a>
  </div>
</div>
<style>
@keyframes ticker-scroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
#news-ticker:hover #ticker-track{animation-play-state:paused}
</style>

<!-- Content -->
<div class="wrap">
  <div style="display:flex;gap:20px;align-items:flex-start;width:100%;">

    <div style="flex:1;min-width:0;">
<!-- Category cards -->
  <p class="section-label">Resources &amp; Tools</p>
  <div class="cat-grid">
    <a class="cat-card" href="/learn.html">
      <div class="cat-icon" style="background:#F1ECF6;">🎓</div>
      <h3>Broker University</h3>
      <p>Training, Medicare basics, sales scripts, compliance guidance.</p>
      <div class="best-for">Best for: Learning &amp; skill-building</div>
    </a>
    <a class="cat-card" href="/tools-perks.html">
      <div class="cat-icon" style="background:#FFE8F3;">🛠️</div>
      <h3>Agent Tools Hub</h3>
      <p>Quoting platforms, plan comparison grid, HRA rates, vendor contacts.</p>
      <div class="best-for">Best for: Working active clients</div>
    </a>
    <a class="cat-card" href="/tools-perks.html">
      <div class="cat-icon" style="background:#E3F5EC;">🎁</div>
      <h3>Agent Benefits</h3>
      <p>Discounts, AHIP access, E&amp;O insurance, CE courses.</p>
      <div class="best-for">Best for: Licensing &amp; compliance support</div>
    </a>
    <a class="cat-card" href="/certs-compliance.html">
      <div class="cat-icon" style="background:#F1ECF6;">📋</div>
      <h3>Certs &amp; Compliance</h3>
      <p>Carrier certifications, CMS guidelines, YourFMO compliance portal.</p>
      <div class="best-for">Best for: Annual certification tracking</div>
    </a>
    <a class="cat-card" href="/retention-toolkit.html">
      <div class="cat-icon" style="background:#FFE8F3;">📧</div>
      <h3>Retention Toolkit</h3>
      <p>Email templates, Year 2 income calculator, AEP retention scripts.</p>
      <div class="best-for">Best for: Keeping your book of business</div>
    </a>
    <a class="cat-card" href="/carrier-contact-guide.html">
      <div class="cat-icon" style="background:#E8F1FA;">📞</div>
      <h3>Carrier Contact Guide</h3>
      <p>Broker contacts, member services, OTC, pharmacy, HRA details for all carriers.</p>
      <div class="best-for">Best for: Client support &amp; escalations</div>
    </a>
    <div class="cat-card" style="cursor:default;position:relative;">
      <div class="cat-icon" style="background:#FFE8F3;">📰</div>
      <h3>THEI Agent Pulse</h3>
      <p>Weekly Medicare industry news, regulatory updates &amp; carrier changes — curated for THEI agents.</p>
      <div class="best-for">Best for: Staying current &amp; informed</div>
      <div style="display:flex;gap:8px;margin-top:12px;padding-top:12px;border-top:1px solid #E7E4ED;">
        <a href="/agent-pulse.html" style="flex:1;display:inline-block;padding:8px 12px;background:#452068;color:#fff;border-radius:6px;font:600 12px/1 Arial,sans-serif;text-align:center;text-decoration:none;">Live Updates</a>
        <a href="/pulse-library.html" style="flex:1;display:inline-block;padding:8px 12px;background:#F1ECF6;color:#452068;border-radius:6px;font:600 12px/1 Arial,sans-serif;text-align:center;text-decoration:none;">View Library</a>
      </div>
    </div>
    <a class="cat-card" href="/sep-tracker.html">
      <div class="cat-icon" style="background:#E3F5EC;">📅</div>
      <h3>SEP Tracker</h3>
      <p>Active Special Enrollment Periods in Florida — always up to date.</p>
      <div class="best-for">Best for: Mid-year enrollment opportunities</div>
    </a>
    <a class="cat-card" href="/chronic-conditions.html">
      <div class="cat-icon" style="background:#FFF3E0;">🏥</div>
      <h3>Chronic Conditions</h3>
      <p>Search which carriers qualify a member's condition for SSBCI benefits — food card, OTC &amp; more.</p>
      <div class="best-for">Best for: Benefit eligibility during enrollment</div>
    </a>

  </div>

  <!-- Resources + Quick Links -->
  <div class="two-col">
    <div class="res-card">
      <h3>Most-Needed Resources</h3>
      <a class="res-item" href="https://docs.google.com/document/d/1xj4I9RV2WixDsb_2FIwQ7xDxVSBYmjutdV8r4tL7Yrk/edit" target="_blank" rel="noopener">
        <span class="res-name">Medicaid Levels Cheat Sheet</span>
        <span class="res-tag tag-pink">Google Doc</span>
      </a>
      <a class="res-item" href="https://docs.google.com/spreadsheets/d/13qp5zQ5FqnoxxOrcfabW21i_O-TZr4hP2UPbEKxoUXA/edit" target="_blank" rel="noopener">
        <span class="res-name">2026 MAPD Plan Comparison</span>
        <span class="res-tag tag-purple">Top Used</span>
      </a>
      <a class="res-item" href="/files/2026-income-limits-ssi-chart.pdf" target="_blank" rel="noopener">
        <span class="res-name">2026 Income Limits (SSI Chart)</span>
        <span class="res-tag tag-green">PDF · Apr 2026</span>
      </a>
      <a class="res-item" href="https://www.sunfirematrix.com/app/agent/yourmedicare" target="_blank" rel="noopener">
        <span class="res-name">Sunfire Quoting Tool</span>
        <span class="res-tag tag-purple">Quoting</span>
      </a>
      <a class="res-item" href="https://login.agentsync.io/" target="_blank" rel="noopener">
        <span class="res-name">AgentSync (Contracting)</span>
        <span class="res-tag tag-purple">Platform</span>
      </a>
      <a class="res-item" href="https://www.ahipmedicaretraining.com/page/login" target="_blank" rel="noopener">
        <span class="res-name">AHIP Medicare Training</span>
        <span class="res-tag tag-pink">Discounted</span>
      </a>
    </div>

    <div class="res-card">
      <h3>Quick Links</h3>
      <a class="ql-item" href="/retention-toolkit.html">
        <div class="ql-left">
          <span class="ql-name">Retention Toolkit</span>
          <span class="ql-desc">Email templates &amp; AEP calendar</span>
        </div>
        <span class="ql-arrow">→</span>
      </a>
      <a class="ql-item" href="/sep-tracker.html">
        <div class="ql-left">
          <span class="ql-name">SEP Tracker</span>
          <span class="ql-desc">Florida disaster SEPs — live data</span>
        </div>
        <span class="ql-arrow">→</span>
      </a>
      <a class="ql-item" href="/carrier-contact-guide.html">
        <div class="ql-left">
